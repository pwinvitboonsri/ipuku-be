// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  STAFF
}

enum Status {
  OPEN
  PAID
  VOIDED
  REFUNDED
}

enum PaymentType {
  CASH
  PROMPTPAY
  /// collected by Grab, settled to the shop later; never in the drawer
  GRAB
}

enum OrderChannel {
  WALK_IN
  GRAB
}

enum StockMovementReason {
  SALE
  RESTOCK
  WASTE
  COUNT_CORRECTION
}

enum AuditAction {
  LOGIN
  LOGOUT

  CREATE_STAFF
  UPDATE_STAFF
  ACTIVATE_STAFF
  DEACTIVATE_STAFF

  CREATE_CATEGORY
  UPDATE_CATEGORY
  ACTIVE_CATEGORY
  DEACTIVATE_CATEGORY

  CREATE_PRODUCT
  UPDATE_PRODUCT
  ACTIVE_PRODUCT
  DEACTIVATE_PRODUCT

  CREATE_ORDER
  PAY_ORDER
  VOID_ORDER
  REFUND_ORDER

  OPEN_CASH_SESSION
  CLOSE_CASH_SESSION

  CREATE_INGREDIENT
  UPDATE_INGREDIENT
  ACTIVE_INGREDIENT
  DEACTIVATE_INGREDIENT

  CREATE_RECIPE
  UPDATE_RECIPE
  DELETE_RECIPE

  CREATE_RECIPE_MODIFIER
  UPDATE_RECIPE_MODIFIER
  DELETE_RECIPE_MODIFIER

  CREATE_MODIFIER_GROUP
  UPDATE_MODIFIER_GROUP
  ACTIVE_MODIFIER_GROUP
  DEACTIVATE_MODIFIER_GROUP

  CREATE_MODIFIER_OPTION
  UPDATE_MODIFIER_OPTION
  ACTIVE_MODIFIER_OPTION
  DEACTIVATE_MODIFIER_OPTION

  ATTACH_MODIFIER_GROUP
  UPDATE_PRODUCT_MODIFIER_GROUP
  DETACH_MODIFIER_GROUP

  STOCK_ADJUSTMENT

  GRAB_ORDER_RECEIVED
  GRAB_ORDER_REJECTED
  GRAB_ORDER_CANCELLED
  GRAB_ORDER_ACKNOWLEDGED

  UPDATE_LOYALTY_PROGRAM
  CREATE_REWARD
  UPDATE_REWARD
  ACTIVE_REWARD
  DEACTIVATE_REWARD
}

/// One row in the points ledger. Balances are the sum of entries; nothing is edited in place.
enum PointsEntryType {
  /// customer claimed a receipt QR
  EARN
  /// a reward code was used on a paid order
  REDEEM
  /// an earn or redeem undone because its order was refunded
  REVERSAL
}

enum RewardType {
  /// fixed baht off the order
  FIXED_DISCOUNT
  /// one item free, up to max_discount_satang
  FREE_ITEM
}

enum RewardCodeStatus {
  /// shown in LINE, holding the points until expires_at
  ACTIVE
  /// validated at the POS and attached to an OPEN order (points still held)
  APPLIED
  /// the order was paid: points deducted
  USED
  /// customer cancelled, or the order it was applied to was voided
  CANCELLED
}

model Staff {
  id        String   @id @default(uuid(7))
  name      String
  pin_hash  String
  role      Role     @default(STAFF)
  is_active Boolean  @default(true)
  update_at DateTime @default(now()) @updatedAt
  create_at DateTime @default(now())

  order             Order[]
  payment           Payment[]
  audit_log         AuditLog[]
  push_subscription PushSubscription[]
  grab_order_ack    GrabOrder[]
  points_entry      PointsEntry[]
  loyalty_program   LoyaltyProgram[]
  opened_by_staff   CashSession[]      @relation("opened_by_staff_id")
  close_by_staff    CashSession[]      @relation("close_by_staff_id")
}

model AuditLog {
  id String @id @default(uuid(7))

  action AuditAction

  staff_id String
  staff    Staff  @relation(fields: [staff_id], references: [id])

  entity_type String
  entity_id   String?

  metadata Json?

  ip_address String?
  user_agent String?

  create_at DateTime @default(now())

  @@index([staff_id])
  @@index([action])
  @@index([entity_type, entity_id])
  @@index([create_at])
}

model Category {
  id         String   @id @default(uuid(7))
  name       String
  sort_order Int
  is_active  Boolean  @default(true)
  update_at  DateTime @default(now()) @updatedAt
  create_at  DateTime @default(now())

  product Product[]
}

model Product {
  id           String   @id @default(uuid(7))
  name         String
  price_satang Int
  is_active    Boolean  @default(true)
  image_url    String?
  update_at    DateTime @default(now()) @updatedAt
  create_at    DateTime @default(now())

  category_id     String
  category        Category               @relation(fields: [category_id], references: [id])
  modifier_group  ProductModifierGroup[]
  order_item      OrderItem[]
  recipe          Recipe[]
  recipe_modifier RecipeModifier[]
  reward          Reward[]
}

model ProductModifierGroup {
  product_id        String
  modifier_group_id String
  /// order of groups within a product
  sort_order        Int      @default(0)
  update_at         DateTime @default(now()) @updatedAt
  create_at         DateTime @default(now())

  product        Product       @relation(fields: [product_id], references: [id])
  modifier_group ModifierGroup @relation(fields: [modifier_group_id], references: [id])

  @@id([product_id, modifier_group_id])
  @@index([modifier_group_id])
}

model ModifierGroup {
  id         String   @id @default(uuid(7))
  name       String
  /// group is required when min_select >= 1
  min_select Int
  max_select Int
  is_active  Boolean  @default(true)
  update_at  DateTime @default(now()) @updatedAt
  create_at  DateTime @default(now())

  product         ProductModifierGroup[]
  modifier_option ModifierOption[]
}

model ModifierOption {
  id                 String   @id @default(uuid(7))
  name               String
  price_delta_satang Int
  /// order of options within a group
  sort_order         Int      @default(0)
  is_active          Boolean  @default(true)
  update_at          DateTime @default(now()) @updatedAt
  create_at          DateTime @default(now())

  order_item_modifier OrderItemModifier[]
  recipe_modifier     RecipeModifier[]
  group_id            String
  modifier_group      ModifierGroup       @relation(fields: [group_id], references: [id])

  @@index([group_id])
}

model Order {
  id              String       @id @default(uuid(7))
  order_number    Int
  status          Status       @default(OPEN)
  channel         OrderChannel @default(WALK_IN)
  subtotal_satang Int
  discount_satang Int          @default(0)
  total_satang    Int
  client_order_id String       @unique
  paid_at         DateTime?
  update_at       DateTime     @default(now()) @updatedAt
  create_at       DateTime     @default(now())

  order_item      OrderItem[]
  payment         Payment[]
  stock_movement  StockMovement[]
  grab_order      GrabOrder?
  claim_token     ClaimToken?
  reward_code     RewardCode?
  points_entry    PointsEntry[]
  cash_session_id String
  staff_id        String
  cash_session    CashSession     @relation(fields: [cash_session_id], references: [id])
  staff           Staff           @relation(fields: [staff_id], references: [id])

  @@unique([cash_session_id, order_number])
  @@index([status])
  @@index([channel])
}

model OrderItem {
  id                    String   @id @default(uuid(7))
  quantity              Int
  unit_price_satang     Int
  line_total_satang     Int
  product_name_snapshot String
  update_at             DateTime @default(now()) @updatedAt
  create_at             DateTime @default(now())

  order_item_modifier OrderItemModifier[]
  order_id            String
  product_id          String
  order               Order               @relation(fields: [order_id], references: [id])
  product             Product             @relation(fields: [product_id], references: [id])

  @@index([order_id])
}

model OrderItemModifier {
  id                 String   @id @default(uuid(7))
  price_delta_satang Int
  name_snapshot      String
  update_at          DateTime @default(now()) @updatedAt
  create_at          DateTime @default(now())

  order_item_id      String
  modifier_option_id String
  order_item         OrderItem      @relation(fields: [order_item_id], references: [id])
  modifier_option    ModifierOption @relation(fields: [modifier_option_id], references: [id])

  @@index([order_item_id])
}

model Payment {
  id            String      @id @default(uuid(7))
  method        PaymentType
  amount_satang Int
  tender_satang Int?
  change_satang Int?
  /// PromptPay slip reference typed by staff (static QR, no gateway)
  reference     String?
  update_at     DateTime    @default(now()) @updatedAt
  create_at     DateTime    @default(now())

  marked_by_staff_id String
  order_id           String
  order              Order  @relation(fields: [order_id], references: [id])
  marked_by_staff    Staff  @relation(fields: [marked_by_staff_id], references: [id])

  @@index([order_id])
}

model CashSession {
  id                   String @id @default(uuid(7))
  opening_float_satang Int
  counted_cash_satang  Int?
  expect_cash_satang   Int?
  variance_satang      Int?

  open_at  DateTime  @default(now())
  close_at DateTime?

  order              Order[]
  opened_by_staff_id String
  close_by_staff_id  String?
  opened_by_staff    Staff   @relation("opened_by_staff_id", fields: [opened_by_staff_id], references: [id])
  close_by_staff     Staff?  @relation("close_by_staff_id", fields: [close_by_staff_id], references: [id])
}

model Ingredient {
  id             String   @id @default(uuid(7))
  name           String
  is_active      Boolean  @default(true)
  unit           String
  /// hundredths of unit (x100), e.g. 25.5 -> 2550
  stock_quantity Int
  /// hundredths of unit (x100), e.g. 25.5 -> 2550
  reorder_level  Int
  update_at      DateTime @default(now()) @updatedAt
  create_at      DateTime @default(now())

  recipe          Recipe[]
  recipe_modifier RecipeModifier[]
  stock_movement  StockMovement[]
}

model Recipe {
  id                String   @id @default(uuid(7))
  /// hundredths of unit (x100), e.g. 25.5 -> 2550
  quantity_per_unit Int
  update_at         DateTime @default(now()) @updatedAt
  create_at         DateTime @default(now())

  product_id    String
  ingredient_id String
  product       Product    @relation(fields: [product_id], references: [id])
  ingredient    Ingredient @relation(fields: [ingredient_id], references: [id])

  @@unique([product_id, ingredient_id])
  @@index([ingredient_id])
}

/// What a modifier option adds to (or takes from) a product's base recipe when sold.
/// Keyed by product × option × ingredient: the same option ("Large") means different
/// ingredients on different products.
model RecipeModifier {
  id             String   @id @default(uuid(7))
  /// hundredths of unit (x100); may be negative, e.g. Oat milk on a latte: whole milk -18000
  quantity_delta Int
  update_at      DateTime @default(now()) @updatedAt
  create_at      DateTime @default(now())

  product_id         String
  modifier_option_id String
  ingredient_id      String
  product            Product        @relation(fields: [product_id], references: [id])
  modifier_option    ModifierOption @relation(fields: [modifier_option_id], references: [id])
  ingredient         Ingredient     @relation(fields: [ingredient_id], references: [id])

  @@unique([product_id, modifier_option_id, ingredient_id])
  @@index([product_id])
  @@index([ingredient_id])
}

model StockMovement {
  id              String              @id @default(uuid(7))
  /// hundredths of unit (x100), e.g. 25.5 -> 2550
  change_quantity Int
  reason          StockMovementReason
  note            String?
  update_at       DateTime            @default(now()) @updatedAt
  create_at       DateTime            @default(now())

  ingredient_id String
  order_id      String?
  ingredient    Ingredient @relation(fields: [ingredient_id], references: [id])
  order         Order?     @relation(fields: [order_id], references: [id])

  @@index([ingredient_id, create_at])
  @@index([order_id])
}

/// One GrabFood order as received from the Grab webhook. order_id is null when we rejected it.
model GrabOrder {
  id                   String    @id @default(uuid(7))
  /// Grab's orderID; the idempotency key for webhook retries
  grab_order_id        String    @unique
  short_order_number   String
  merchant_id          String
  /// latest state pushed by Grab (e.g. DRIVER_ALLOCATED, COLLECTED, CANCELLED)
  state                String
  grab_subtotal_satang Int
  raw_payload          Json
  rejected_reason      String?
  acknowledged_at      DateTime?
  update_at            DateTime  @default(now()) @updatedAt
  create_at            DateTime  @default(now())

  order_id                 String? @unique
  order                    Order?  @relation(fields: [order_id], references: [id])
  acknowledged_by_staff_id String?
  acknowledged_by_staff    Staff?  @relation(fields: [acknowledged_by_staff_id], references: [id])

  @@index([acknowledged_at])
}

/// A device (browser) that gets Web Push alerts, e.g. new Grab orders
model PushSubscription {
  id              String    @id @default(uuid(7))
  endpoint        String    @unique
  p256dh          String
  auth            String
  user_agent      String?
  last_success_at DateTime?
  update_at       DateTime  @default(now()) @updatedAt
  create_at       DateTime  @default(now())

  staff_id String
  staff    Staff  @relation(fields: [staff_id], references: [id])

  @@index([staff_id])
}

/// Loyalty settings (a single row, id 1). Rule changes apply to orders paid afterwards.
model LoyaltyProgram {
  id                  Int      @id @default(1)
  /// earn points_per_unit for every unit_satang of the paid total, rounded down
  points_per_unit     Int      @default(1)
  unit_satang         Int      @default(1000)
  /// how long a receipt QR can be claimed after payment
  claim_valid_hours   Int      @default(24)
  /// how long a reward code shown in LINE stays valid (points are held meanwhile)
  reward_code_minutes Int      @default(10)
  /// PDPA consent text version; members who accepted an older one are asked again
  consent_version     String   @default("2026-10-21")
  update_at           DateTime @default(now()) @updatedAt

  update_by_staff_id String?
  update_by_staff    Staff?  @relation(fields: [update_by_staff_id], references: [id])
}

/// Anyone who added the shop OA as a friend (from follow/unfollow webhooks). Not a member until they consent.
model LineContact {
  line_user_id  String    @id
  is_friend     Boolean   @default(true)
  followed_at   DateTime?
  unfollowed_at DateTime?
  update_at     DateTime  @default(now()) @updatedAt
  create_at     DateTime  @default(now())
}

/// A LINE user who accepted the PDPA consent. Shown as IPK-000042 (member_no).
model Member {
  id              String   @id @default(uuid(7))
  member_no       Int      @unique @default(autoincrement())
  /// per LINE Provider: the same person has another userId under a different Provider
  line_user_id    String   @unique
  /// from the LINE profile, refreshed whenever the member opens the LIFF app
  display_name    String?
  picture_url     String?
  consent_version String
  consented_at    DateTime
  update_at       DateTime @default(now()) @updatedAt
  create_at       DateTime @default(now())

  points_entry PointsEntry[]
  claim_token  ClaimToken[]
  reward_code  RewardCode[]

  @@index([display_name])
}

/// Append-only points ledger. Corrections happen only through refunds (REVERSAL rows).
model PointsEntry {
  id        String          @id @default(uuid(7))
  type      PointsEntryType
  /// signed: + earn, − redeem, opposite sign of the reversed entry
  points    Int
  note      String?
  create_at DateTime        @default(now())

  member_id      String
  member         Member       @relation(fields: [member_id], references: [id])
  order_id       String?
  order          Order?       @relation(fields: [order_id], references: [id])
  claim_token_id String?      @unique
  claim_token    ClaimToken?  @relation(fields: [claim_token_id], references: [id])
  reward_code_id String?      @unique
  reward_code    RewardCode?  @relation(fields: [reward_code_id], references: [id])
  /// staff behind a redeem or reversal; null when the customer earned through LINE
  staff_id       String?
  staff          Staff?       @relation(fields: [staff_id], references: [id])
  /// the entry this one undoes; unique so an entry is reversed at most once
  reverses_id    String?      @unique
  reverses       PointsEntry? @relation("reversal", fields: [reverses_id], references: [id])
  reversed_by    PointsEntry? @relation("reversal")

  @@index([member_id, create_at])
  @@index([order_id])
  @@index([type, create_at])
}

/// One-time "scan to collect points" token for a paid walk-in order (QR on screen + receipt).
model ClaimToken {
  id           String    @id @default(uuid(7))
  /// random, in the QR URL
  token        String    @unique
  /// 6 characters printed under the QR for manual entry
  code         String    @unique
  /// points this order earns, fixed at payment with the rule in force then
  points       Int
  total_satang Int
  expires_at   DateTime
  claimed_at   DateTime?
  create_at    DateTime  @default(now())

  order_id  String  @unique
  order     Order   @relation(fields: [order_id], references: [id])
  member_id String?
  member    Member? @relation(fields: [member_id], references: [id])

  points_entry PointsEntry?

  @@index([expires_at])
}

/// Something members spend points on. Deactivating hides it; codes already issued still work until they expire.
model Reward {
  id                  String     @id @default(uuid(7))
  name                String
  cost_points         Int
  type                RewardType
  /// FIXED_DISCOUNT: baht off the order
  discount_satang     Int?
  /// FREE_ITEM: this product (any options) is free, up to max_discount_satang
  max_discount_satang Int?
  /// photo shown in LINE and the back office (R2 public URL); a free item falls back to its product's photo
  image_url           String?
  sort_order          Int        @default(0)
  is_active           Boolean    @default(true)
  update_at           DateTime   @default(now()) @updatedAt
  create_at           DateTime   @default(now())

  product_id String?
  product    Product? @relation(fields: [product_id], references: [id])

  reward_code RewardCode[]
}

/// A reward the member chose in LINE: shown as a rotating QR (code + time-based token) or the plain code.
model RewardCode {
  id              String           @id @default(uuid(7))
  /// 6 characters, the fallback typed at the POS
  code            String           @unique
  /// secret for the rotating QR token; only the member's LIFF app gets it
  seed            String
  status          RewardCodeStatus @default(ACTIVE)
  /// snapshots, so history reads right after the reward is edited
  reward_name     String
  cost_points     Int
  /// discount actually given, set when applied to an order
  discount_satang Int?
  expires_at      DateTime
  applied_at      DateTime?
  used_at         DateTime?
  cancelled_at    DateTime?
  update_at       DateTime         @default(now()) @updatedAt
  create_at       DateTime         @default(now())

  member_id String
  member    Member  @relation(fields: [member_id], references: [id])
  reward_id String
  reward    Reward  @relation(fields: [reward_id], references: [id])
  /// the order it discounts; one reward per order
  order_id  String? @unique
  order     Order?  @relation(fields: [order_id], references: [id])

  points_entry PointsEntry?

  @@index([member_id, status])
}

/// LINE webhook events already handled; LINE may redeliver the same webhookEventId.
model LineWebhookEvent {
  id        String   @id
  type      String
  create_at DateTime @default(now())

  @@index([create_at])
}
