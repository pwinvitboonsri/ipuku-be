# Copy to .env.development / .env.test / .env.production and fill in real values.
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# at least 32 characters
JWT_SECRET=
JWT_EXPIRES_IN=1d

# shared with the POS device for GET /auth (staff list)
HMAC_SECRET=

# shared with the Next.js BFF (x-bff-key) so rate limits apply per tablet IP, at least 32 characters; empty = off
BFF_KEY=

# comma-separated frontend origins; empty = CORS off
CORS_ORIGINS=http://localhost:5173

# requests per minute per IP
THROTTLE_LIMIT=600
LOGIN_THROTTLE_LIMIT=10

# Cloudflare R2 for product images (optional; empty = image upload off)
# token: R2 → Manage API tokens → Object Read & Write, scoped to the bucket
# R2 → Overview → S3 API endpoint (account level, no bucket path)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ipuku-images
# public base URL of the bucket: https://pub-xxxx.r2.dev (dev) or a custom domain (prod), no trailing slash
R2_PUBLIC_URL=
